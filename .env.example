# Application Environment
APP_ENV=development
APP_NAME=AutonomousBusinessAgent
APP_SECRET=placeholder_app_secret_replace_with_secure_random_string
API_V1_STR=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache / Distributed Lock / Queue
REDIS_URL=redis://localhost:6379/0

# LLM Provider - Primary: Ollama Cloud
OLLAMA_BASE_URL=https://api.ollama.com/v1
OLLAMA_API_KEY=placeholder_ollama_api_key
OLLAMA_MODEL=qwen2.5:72b
OLLAMA_TIMEOUT_SECONDS=60

# LLM Provider - Secondary / Complex Reasoning: NVIDIA NIM
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=placeholder_nim_api_key
NIM_MODEL=meta/llama-3.1-70b-instruct
NIM_HARD_RPM_LIMIT=30
NIM_TARGET_RPM=28
NIM_TIMEOUT_SECONDS=90

# Payments: Dodo Payments
DODO_API_KEY=placeholder_dodo_api_key
DODO_WEBHOOK_SECRET=placeholder_dodo_webhook_secret
DODO_ENVIRONMENT=test
DODO_API_URL=https://test.dodopayments.com

# Communication - Email (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=placeholder_smtp_password
SMTP_FROM_EMAIL=agent@example.com
SMTP_FROM_NAME="Autonomous Agency"

# Communication - WhatsApp (Official Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_id
WHATSAPP_ACCESS_TOKEN=placeholder_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_verify_token

# Communication - Voice (Optional WebRTC/Twilio Adapter)
VOICE_ENABLED=false
VOICE_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Storage (Local Filesystem or S3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./workspace/storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# Agent Execution Limits & Guardrails
MAX_ACTIVE_PROJECTS=10
MAX_WORKERS=8
MAX_BROWSER_SESSIONS=4
MAX_TERMINAL_PROCESSES=4
MAX_TOOL_CALLS=50
MAX_LLM_CALLS=100
AGENT_MAX_RUNTIME_SECONDS=3600
AGENT_MAX_STEPS=100
AGENT_MAX_RETRIES=3
AGENT_MAX_COST=25.0

# Outreach & Spam Prevention Policy Limits
OUTREACH_DAILY_LIMIT=20
OUTREACH_HOURLY_LIMIT=5
OUTREACH_COOLDOWN_DAYS=30
MIN_PROJECT_PRICE=150.0
MAX_DISCOUNT_PERCENT=15.0
MIN_PROFIT_MARGIN=40.0
